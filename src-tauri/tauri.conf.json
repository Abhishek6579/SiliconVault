{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiliconVault",
  "version": "0.2.0-beta.2",
  "identifier": "com.siliconvault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SiliconVault",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "version": "0.1.1.3"
      }
    },
    "license": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MDgzQkREMTM1QzkzOUYKUldTZmsxd1QzVHNJZVhXRjZTS3EwVG52eDUwUmp0aUtlWEZ1S2VOU1ZuYnROTWl3cTBQYTh1UTQK",
      "endpoints": [
        "https://raw.githubusercontent.com/Abhishek6579/SiliconVault/slave/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
